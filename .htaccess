RewriteEngine On

# 1. Force HTTPS and canonical domain on live server (vocationtravels.in)
RewriteCond %{HTTP_HOST} ^(www\.)?vocationtravels\.in$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect root request to public/index.php
# (Must run before the serve-existing-directory rule below)
RewriteRule ^$ public/index.php [L]

# 3. If the request is for an existing real file or directory, serve directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Legacy 301 redirects for older blog-detail URLs
RewriteRule ^blog-detail2340\.html$ blog-details/top-10-destinations/ [R=301,L]
RewriteRule ^blog-detaile252\.html$ blog-details/luxury-travel-hacks/ [R=301,L]
RewriteRule ^blog-detailfd55\.html$ blog-details/hidden-gems-india/ [R=301,L]

# 5. Pretty URLs for core pages
RewriteRule ^about/?$ public/about.php [L,QSA]
RewriteRule ^contact/?$ public/contact.php [L,QSA]
RewriteRule ^blogs/?$ public/blog.php [L,QSA]
RewriteRule ^travel-package/?$ public/travel-package.php [L,QSA]
RewriteRule ^package/([a-zA-Z0-9-]+)/?$ public/package-details.php?slug=$1 [L,QSA]
RewriteRule ^seo-report/?$ public/seo-report.php [L,QSA]
RewriteRule ^vip-concierge/?$ public/vipconcierge.php [L,QSA]
RewriteRule ^privacy-policy/?$ public/privacy-policy.php [L,QSA]
RewriteRule ^terms-and-conditions/?$ public/terms-and-conditions.php [L,QSA]

# 6. Dynamic XML Sitemap (pulls all 42+ visa cities, blogs, services automatically)
RewriteRule ^sitemap\.xml$ public/sitemap.php [L,QSA]

# 7. Category & Service pages
RewriteRule ^category/([a-zA-Z0-9-]+)/?$ public/category.php?alias=$1 [L,QSA]
RewriteRule ^services/?$ public/service.php [L,QSA]
RewriteRule ^services/([a-zA-Z0-9-]+)/?$ public/service.php?alias=$1 [L,QSA]

# 8. Visa Services Hub & Country-specific pages
RewriteRule ^visa-services/?$ public/visa-services.php [L,QSA]
RewriteRule ^visa-services/([a-zA-Z0-9-]+)/?$ public/visa-country.php?country=$1 [L,QSA]

# 9. All-India Visa Consultants City Pages (Local SEO for 40+ Indian Cities)
RewriteRule ^visa-consultants-([a-zA-Z0-9-]+)/?$ public/visa-consultants.php?city=$1 [L,QSA]

# 10. Products & Blog details
RewriteRule ^product-details/([a-zA-Z0-9-]+)/?$ public/product-details.php?alias=$1 [L,QSA]
RewriteRule ^blog-details/([^/]+)/?$ public/blog-details.php?alias=$1 [L,QSA]

# 11. Assets & Public Fallback (routes remaining requests to public/ folder)
RewriteCond %{REQUEST_URI} !/public/
RewriteCond %{REQUEST_URI} !/admin/
RewriteCond %{REQUEST_URI} !/util/
RewriteCond %{REQUEST_URI} !/uploads/
RewriteRule ^(.*)$ public/$1 [L]

# 12. Security: Deny direct access to sensitive configuration, database & git files
<FilesMatch "(\.env|\.git|\.gitignore|composer\.(json|lock)|\.sql|\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 13. Enable GZIP compression for speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# 14. Browser Caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 15. PHP 8.1+ Compatibility Handler for Hostinger / cPanel
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>